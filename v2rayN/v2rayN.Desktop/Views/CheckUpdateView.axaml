<UserControl
    x:Class="v2rayN.Desktop.Views.CheckUpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="vms:CheckUpdateViewModel"
    Design.DataContext="{x:Static dd:DesignData.CheckUpdate}"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="ListBox#lstCheckUpdates > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox#lstCheckUpdates > ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource GlassRowHoverBrush}" />
        </Style>
        <Style Selector="ListBox#lstCheckUpdates > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource GlassRowSelectedBrush}" />
        </Style>
    </UserControl.Styles>

    <Border
        Background="{DynamicResource GlassDrawerBrush}"
        BorderBrush="{DynamicResource GlassBorderBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="14">
    <DockPanel Margin="12">
        <Grid
            Margin="4,2,4,10"
            ColumnDefinitions="*,Auto"
            DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="PageTitle" Text="Updates" />
                    <Border Classes="CountPill">
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource GlassTextSecondaryBrush}"
                            Text="{Binding ComponentCount}" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="PageSubtitle" Text="Keep every core and geo file current." />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="btnCheckOnly"
                    Classes="Soft"
                    Content="{x:Static resx:ResUI.menuCheckOnly}" />
                <Button x:Name="btnCheckUpdate" Classes="Primary">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon
                                Width="14"
                                Height="14"
                                Data="{StaticResource SemiIconRefresh}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.menuCheckUpdate}" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Margin="4,0,4,8"
            Classes="GlassInset"
            DockPanel.Dock="Top">
            <Grid
                Margin="14,10"
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="StatLabel"
                    Text="UPDATE CHANNELS" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,3,16,0"
                    Classes="PageSubtitle"
                    Text="Choose how components are fetched. Pre-release builds may be unstable."
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ToggleSwitch x:Name="togEnableCheckPreReleaseUpdate" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource GlassTextPrimaryBrush}"
                            Text="Include pre-release builds" />
                    </StackPanel>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ToggleSwitch x:Name="togEnableUpdateViaProxy" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource GlassTextPrimaryBrush}"
                            Text="Download through proxy" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Margin="16,8,16,12"
            Classes="PageSubtitle"
            DockPanel.Dock="Bottom"
            Text="Selected components are checked together. Updates come from official release pages."
            TextWrapping="Wrap" />

        <Border
            Margin="4,0,4,0"
            Classes="GlassInset"
            ClipToBounds="True">
            <Grid>
                <ListBox
                    x:Name="lstCheckUpdates"
                    Background="Transparent"
                    BorderThickness="0"
                    IsVisible="{Binding !BlIsEmpty}"
                    ItemsSource="{Binding CheckUpdateModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14,10"
                                BorderBrush="{DynamicResource GlassHairlineBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">
                                <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                        Text="{Binding CoreTypeDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                        Text="{Binding Remarks}"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="togAutoRefresh"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ListBox>

                <StackPanel
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding BlIsEmpty}"
                    Spacing="5">
                    <Path
                        Width="80"
                        Height="36"
                        HorizontalAlignment="Center"
                        Data="{StaticResource ArONMarkGeometry}"
                        Fill="{DynamicResource GlassThemeIconBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource GlassTextPrimaryBrush}"
                        Text="Nothing to check" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}"
                        Text="Core components will appear here once they are available."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
    </Border>
</UserControl>
