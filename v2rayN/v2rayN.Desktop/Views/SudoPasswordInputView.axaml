<UserControl
    x:Class="v2rayN.Desktop.Views.SudoPasswordInputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    mc:Ignorable="d">

    <Border
        Width="480"
        Background="{DynamicResource GlassDrawerBrush}"
        BorderBrush="{DynamicResource GlassBorderBrush}"
        BorderThickness="1"
        BoxShadow="{DynamicResource GlassDrawerShadow}"
        ClipToBounds="True"
        CornerRadius="18">
        <DockPanel Margin="18">
            <StackPanel
                Margin="2,0,2,14"
                DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="10">
                <PathIcon
                    Width="20"
                    Height="20"
                    Data="{StaticResource SemiIconBolt}"
                    Foreground="{DynamicResource GlassThemeIconBrush}" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource GlassTextPrimaryBrush}"
                        Text="Administrator password" />
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}"
                        Text="Required to change system proxy settings." />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Margin="0,10,0,0"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="btnSave"
                    Width="132"
                    Classes="Primary"
                    Content="{x:Static resx:ResUI.TbConfirm}"
                    IsDefault="True" />
                <Button
                    x:Name="btnCancel"
                    Width="104"
                    Classes="Soft"
                    Content="{x:Static resx:ResUI.TbCancel}"
                    IsCancel="True" />
            </StackPanel>

            <Border Classes="FormCard">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionLabel" Text="SUDO" />
                    <TextBlock Classes="FieldLabel" Text="{x:Static resx:ResUI.TbSettingsLinuxSudoPassword}" />
                    <TextBox
                        x:Name="txtPassword"
                        Classes="revealPasswordButton"
                        Focusable="True"
                        PlaceholderText="Enter your password" />
                    <TextBlock
                        Classes="FieldHint"
                        Text="{x:Static resx:ResUI.TbSettingsLinuxSudoPasswordTip}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
