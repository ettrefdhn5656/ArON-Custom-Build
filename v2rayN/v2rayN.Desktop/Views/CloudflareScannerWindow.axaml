<Window
    x:Class="v2rayN.Desktop.Views.CloudflareScannerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.CloudflareScannerTitle}"
    Width="960"
    Height="700"
    MinWidth="860"
    MinHeight="560"
    x:DataType="vms:CloudflareScannerViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="DataGridCellBackground" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridRowBackground" Color="{DynamicResource GlassRowCardColor}" />
        <SolidColorBrush x:Key="DataGridRowPointeroverBackground" Color="{DynamicResource GlassRowHoverColor}" />
        <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="{DynamicResource GlassRowSelectedColor}" />
        <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="{DynamicResource GlassRowSelectedHoverColor}" />
        <SolidColorBrush x:Key="DataGridColumnHeaderBackground" Color="{DynamicResource GlassColumnHeaderColor}" />
        <CornerRadius x:Key="DataGridRowCornerRadius">12</CornerRadius>
        <Thickness x:Key="DataGridRowMargin">6,4</Thickness>
    </Window.Resources>

    <Border
        Margin="12"
        Classes="WindowShell"
        ClipToBounds="True">
        <DockPanel>
            <Border Classes="DialogHeader" DockPanel.Dock="Top">
                <DockPanel>
                    <Button
                        x:Name="btnCloseHeader"
                        VerticalAlignment="Center"
                        Classes="IconButton ToolGlass"
                        DockPanel.Dock="Right"
                        ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource SemiIconClose}" />
                    </Button>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <PathIcon
                            Width="20"
                            Height="20"
                            Data="{StaticResource SemiIconGlobeStroked}"
                            Foreground="{DynamicResource GlassThemeIconBrush}" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="WindowTitle" Text="{x:Static resx:ResUI.CloudflareScannerTitle}" />
                                <Border Classes="CountPill" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                        Text="{Binding ResultCount}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                MaxWidth="720"
                                FontSize="10.5"
                                Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                Text="{x:Static resx:ResUI.CloudflareScannerDesc}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border
                Margin="14,10,14,14"
                Padding="14,8"
                Classes="GlassInset"
                DockPanel.Dock="Bottom">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <PathIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Data="{StaticResource SemiIconInfoCircle}"
                            Foreground="{DynamicResource GlassThemeIconBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="PageSubtitle"
                            Text="Nothing leaves this device until you copy a result." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="btnCopySelected"
                            Classes="Ghost"
                            Content="{x:Static resx:ResUI.TbCopySelected}" />
                        <Button
                            x:Name="btnCopyAllWorking"
                            Classes="Ghost"
                            Content="{x:Static resx:ResUI.TbCopyAllWorking}" />
                        <Button
                            x:Name="btnClose"
                            Width="104"
                            Classes="Soft"
                            Content="Close"
                            IsCancel="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="4,8,4,4"
                Classes="FormCard"
                DockPanel.Dock="Top">
                <Grid ColumnDefinitions="*,16,150,16,150" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,6"
                            Classes="SectionLabel"
                            Text="{x:Static resx:ResUI.TbSubnetRange}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding RangePresets}"
                            SelectedItem="{Binding SelectedRangePreset}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,6"
                            Classes="SectionLabel"
                            Text="{x:Static resx:ResUI.TbPort}" />
                        <NumericUpDown
                            Maximum="65535"
                            Minimum="1"
                            Value="{Binding Port}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock
                            Margin="0,0,0,6"
                            Classes="SectionLabel"
                            Text="{x:Static resx:ResUI.TbSampleCount}" />
                        <NumericUpDown
                            Maximum="2000"
                            Minimum="10"
                            Value="{Binding SampleCount}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,12,0,0">
                        <TextBlock
                            Margin="0,0,0,6"
                            Classes="SectionLabel"
                            Text="{x:Static resx:ResUI.TbTestHost}" />
                        <TextBox
                            PlaceholderText="speed.cloudflare.com"
                            Text="{Binding TestHost}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,12,0,0">
                        <TextBlock
                            Margin="0,0,0,6"
                            Classes="SectionLabel"
                            Text="{x:Static resx:ResUI.TbThreads}" />
                        <NumericUpDown
                            Maximum="64"
                            Minimum="1"
                            Value="{Binding ThreadCount}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="4"
                        Margin="0,12,0,0"
                        VerticalAlignment="Bottom">
                        <CheckBox
                            Content="{x:Static resx:ResUI.TbEnableSpeedTest}"
                            IsChecked="{Binding EnableSpeedTest}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="4,4,4,4"
                Padding="14,10"
                Classes="GlassInset"
                DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,8,Auto,20,*,20,Auto">
                    <Button
                        x:Name="btnStart"
                        MinWidth="118"
                        Classes="Primary"
                        Content="{x:Static resx:ResUI.TbStartScan}"
                        IsDefault="True"
                        IsEnabled="{Binding !IsScanning}" />
                    <Button
                        x:Name="btnStop"
                        Grid.Column="2"
                        MinWidth="96"
                        Classes="Soft"
                        Content="{x:Static resx:ResUI.TbStopScan}"
                        IsEnabled="{Binding IsScanning}" />
                    <StackPanel
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <ProgressBar
                            Height="6"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressPercentage}" />
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{DynamicResource GlassTextSecondaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Classes="CountPill">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                Text="{Binding ScannedCount, StringFormat='Tested  {0}'}" />
                        </Border>
                        <Border Classes="ActivePill">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource GlassPresenceBrush}" />
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource GlassTextPrimaryBrush}"
                                    Text="{Binding WorkingCount, StringFormat='Working  {0}'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="4,4,4,0"
                Padding="0"
                Classes="FormCard"
                ClipToBounds="True">
                <Grid>
                    <DataGrid
                        x:Name="gridResults"
                        Margin="6"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        IsVisible="{Binding !BlIsEmpty}"
                        ItemsSource="{Binding Results}"
                        RowHeight="44"
                        SelectedItem="{Binding SelectedResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding Ip}"
                                Header="IP ADDRESS" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Port}"
                                Header="{x:Static resx:ResUI.TbPort}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding PingDisplay}"
                                Header="PING" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding DataCenter}"
                                Header="{x:Static resx:ResUI.TbDataCenter}" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Status}"
                                Header="STATUS" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Speed}"
                                Header="SPEED" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        MaxWidth="390"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding BlIsEmpty}"
                        Spacing="5">
                        <Path
                            Width="80"
                            Height="36"
                            HorizontalAlignment="Center"
                            Data="{StaticResource ArONMarkGeometry}"
                            Fill="{DynamicResource GlassThemeIconBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource GlassTextPrimaryBrush}"
                            Text="No scan results yet" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource GlassTextSecondaryBrush}"
                            Text="Run a scan to find Cloudflare addresses with the best latency."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Classes="Primary"
                            Command="{Binding StartScanCmd}"
                            Content="Start a scan" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
